.agents/

# Python cache (created by ad-hoc `python3 tools/picker.py` runs)
__pycache__/
**/__pycache__/
*.pyc

# Backup / restore artifacts (never commit)
*.bak
*.orig

# In-process / per-run state files (not code)
boot_profile.json
attack_runtime.json
adb_last_known.json

# One-off root build outputs (have source in cmd/<name>/; can be re-derived).
# Patterns are root-anchored so the cmd/<name>/ source directories are NOT ignored.
/capture_template

# Freebuff agent state (project id, local session data) — never part of the build.
.freebuff/
